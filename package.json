{
  "name": "crypto-order-book",
  "private": true,
  "version": "0.0.1",
  "license": "UNLICENSED",
  "author": "Timur Jalilov <timurjalilov1@gmail.com>",
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check --write",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "release": "bash scripts/release-tag.sh",
    "sweep": "bash scripts/branch-sweep.sh",
    "deploy:dev": "wrangler deploy --env dev",
    "deploy:uat": "wrangler deploy --env uat",
    "deploy:prod": "wrangler deploy --env prod",
    "cf-typegen": "wrangler types worker/worker-configuration.d.ts --include-env false",
    "cf-typegen:check": "wrangler types worker/worker-configuration.d.ts --include-env false --check",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/react-query": "^5.102.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^6.1.4",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.5",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "^24.13.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/ui": "4.1.10",
    "husky": "^9.1.7",
    "jsdom": "30.0.1",
    "lint-staged": "^17.5.1",
    "secretlint": "^13.0.5",
    "shadcn": "^4.21.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.0",
    "vitest": "5.0.0",
    "wrangler": "^4.131.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": "biome check --write --no-errors-on-unmatched",
    "*": "secretlint --no-glob"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "body-max-line-length": [
        0,
        "always"
      ],
      "footer-max-line-length": [
        0,
        "always"
      ]
    }
  }
}
